{
  "name": "meshrik-meshcore-frontend",
  "private": true,
  "version": "3.17.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "docker:typecheck": "npm run typecheck -- --project tsconfig.docker.json",
    "packaged-build": "vite build --outDir prebuilt",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "node node_modules/@typescript/native/bin/tsc",
    "api:schema": "uv run --project .. python ../scripts/build/dump_api_specs.py openapi --openapi-only",
    "api:types": "openapi-typescript openapi/openapi.json -o src/generated/api-schema.ts && prettier --write src/generated/api-schema.ts --log-level warn",
    "api:generate": "npm run api:schema && npm run api:types",
    "api:check": "npm run api:generate && git diff --exit-code -- openapi/openapi.json src/generated/api-schema.ts",
    "i18n:extract": "npm run i18n:update",
    "i18n:update": "lingui extract --clean",
    "i18n:check": "npm run i18n:update && npm run i18n:compile && git diff --exit-code -- src/locales",
    "i18n:compile": "lingui compile --strict",
    "lint": "eslint src/ --cache",
    "lint:fix": "eslint src/ --fix --cache",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@michaelhart/meshcore-decoder": "npm:meshcore-decoder-multibyte-patch@0.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/charts": "1.1.0",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/query-db-collection": "^1.4.3",
    "@tanstack/react-db": "^0.5.8",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.8",
    "@tanstack/store": "^0.11.2",
    "@uiw/react-codemirror": "^4.25.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "d3-force-3d": "^3.0.6",
    "lucide-react": "^1.0.0",
    "maplibre-gl": "^6.13.0",
    "meshcore-hashtag-cracker": "^1.11.0",
    "nosleep.js": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.3",
    "react-swipeable": "^7.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@lingui/cli": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.10",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.1.3",
    "vitest": "^5.0.0"
  }
}
