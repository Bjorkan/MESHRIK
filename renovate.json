{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts",
    ":maintainLockFilesMonthly"
  ],
  "timezone": "Europe/Stockholm",
  "schedule": [
    "* 0-5 * * *"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "automerge": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/fixtures/**",
    "**/.venv/**",
    "frontend/lib/meshcore-decoder/**"
  ],
  "packageRules": [
    {
      "description": "Update React and its type packages together",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React"
    },
    {
      "description": "Update the Vite build and test tools together",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "vite",
        "vitest",
        "@vitejs/plugin-react"
      ],
      "groupName": "Vite and Vitest"
    },
    {
      "description": "Keep UI component libraries grouped by ecosystem",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "@radix-ui/**"
      ],
      "groupName": "Radix UI"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "@tanstack/react-query",
        "@tanstack/react-virtual"
      ],
      "groupName": "TanStack"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "@codemirror/**",
        "@uiw/react-codemirror"
      ],
      "groupName": "CodeMirror"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchPackageNames": [
        "three",
        "@types/three"
      ],
      "groupName": "Three.js"
    },
    {
      "description": "Review patched decoder alias PRs manually before merging",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@michaelhart/meshcore-decoder",
        "meshcore-decoder-multibyte-patch"
      ],
      "prBodyNotes": [
        "Verify that the custom multibyte decoder behavior is preserved."
      ]
    },
    {
      "description": "Review the MeshCore radio integration PR manually before merging",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "meshcore"
      ],
      "prBodyNotes": [
        "Check MeshCore device compatibility and radio-related behavior manually."
      ]
    },
    {
      "description": "Backend test and development tooling",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python dev tools"
    },
    {
      "description": "Playwright E2E needs a physical MeshCore radio and is not part of standard CI",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "tests/e2e/package.json"
      ],
      "prBodyNotes": [
        "Playwright E2E tests require a connected MeshCore radio; run them manually before merging."
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Track base image security updates through immutable Docker digests",
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true
    }
  ]
}
